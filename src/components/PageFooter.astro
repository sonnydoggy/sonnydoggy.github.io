---
// i made a component for 88x31s, if you find it easier
// you can import it and use it in the header the same way
// i'd name it 88x31 but we can't start shit with numbers :c
import Badge from "./Badge.astro";
---

<header class="page-header">
    <!-- new header box -->
    <div class="header-boxes">
        <!-- box 1 -->
        <div class="header-box">
            <img
                class="header-image"
                src="/img/sonnyminion.png"
                alt="description"
            />
            <p class="header-text">my dog is cool and awesome</p>
            <hr class="header-divider" />
            <div class="header-badges">
                <Badge
                    src="/88x31/sonnyminion.gif"
                    alt="woof woof kaboom"
                    href="https://www.youtube.com/@sawneydawgey/"
                />
                <Badge
                    src="/88x31/sonnyminion.gif"
                    alt="woof woof kaboom"
                    href="https://www.youtube.com/@sawneydawgey/"
                />
            </div>
        </div>

        <!-- box 2 -->
        <div class="header-box">
            <img
                class="header-image"
                src="/img/nothing project.jpg"
                alt="description"
            />
            <p class="header-text">
                <b>nothing project</b>
            </p>
            <hr class="header-divider" />
            <div class="header-badges">
                <Badge
                    src="/88x31/sonnyminion.gif"
                    alt="woof woof kaboom"
                    href="https://www.youtube.com/@sawneydawgey/"
                />
            </div>
        </div>

        <!-- box 3, 4, however many you want... -->
    </div>
</header>

<footer class="page-footer">
    <div class="content">
        <div class="left">
            <h2 class="title">sonnydoggy</h2>
            <p class="copy">&copy; 2026</p>
        </div>
        <div class="right">
            <p>pee pee poo poo</p>
        </div>
    </div>
    <div class="footer-badges">
        <!-- example -->
        <Badge
            src="/88x31/sonnyminion.gif"
            alt="woof woof kaboom"
            href="https://www.youtube.com/@sawneydawgey/"
        />
        <Badge
            src="/88x31/sonnyminion.gif"
            alt="woof woof kaboom"
            href="https://www.youtube.com/@sawneydawgey/"
        />
        <Badge
            src="/88x31/sonnyminion.gif"
            alt="woof woof kaboom"
            href="https://www.youtube.com/@sawneydawgey/"
        />
        <Badge
            src="/88x31/sonnyminion.gif"
            alt="woof woof kaboom"
            href="https://www.youtube.com/@sawneydawgey/"
        />
        <Badge
            src="/88x31/sonnyminion.gif"
            alt="woof woof kaboom"
            href="https://www.youtube.com/@sawneydawgey/"
        />
    </div>
</footer>
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid var(--base02);
        align-items: center;
    }

    .header-boxes {
        display: flex;
        gap: 1rem; /* space between boxes */
        flex-wrap: wrap; /* wraps to next line if too many */
    }

    .header-box {
        display: flex;
        --boxsize: 15rem;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--base03);
        background-color: var(--base01); /* subtle background tint */
        width: var(--boxsize); /* shrinks to the image width */
    }

    .header-image {
        height: var(--boxsize);
        width: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .header-badges {
        display: flex;
        align-items: left;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 0.5rem;
    }

    .header-text {
        margin: 0;
        padding: 0.25rem 0.5rem;
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .header-divider {
        width: 100%;
        border: none;
        border-top: 1px solid var(--base03);
        margin: 0;
    }

    .page-footer {
        border-top: 1px solid var(--base03);
        height: 6rem;
        padding-block: 0.5rem;
    }

    .content {
        display: flex;
        justify-content: space-between;
    }

    .footer-left {
        display: flex;
        flex-direction: column;
    }

    .title,
    .copy {
        margin: 0;
    }

    .footer-badges {
        display: flex;
        flex-wrap: wrap;
        margin-top: 0.5rem;
        /*
                if you want to add space between the 88x31s:
                gap: 0.5rem;
                */
    }
</style>

