<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid var(--base02);
        align-items: center;
    }

    .header-boxes {
        display: flex;
        gap: 1rem; /* space between boxes */
        flex-wrap: wrap; /* wraps to next line if too many */
    }

    .header-box {
        display: flex;
        --boxsize: 15rem;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--base03);
        background-color: var(--base01); /* subtle background tint */
        width: var(--boxsize); /* shrinks to the image width */
    }

    .header-image {
        height: var(--boxsize);
        width: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .header-badges {
        display: flex;
        align-items: left;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 0.5rem;
    }

    .header-text {
        padding: 0.25rem 0.5rem;
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
        margin: 0;
    }

    .header-date {
        text-align: right;
        font-size: 0.9em;
        opacity: 0.75;
        font-style: italic;
    }

    .header-divider {
        width: 100%;
        border-top: 2px solid var(--base03);
        margin: 0;
    }

    .page-footer {
        border-top: 1px solid var(--base03);
        height: 6rem;
        padding-block: 0.5rem;
    }

    .content {
        display: flex;
        justify-content: space-between;
    }

    .footer-left {
        display: flex;
        flex-direction: column;
    }

    .title,
    .copy {
        margin: 0;
    }

    .footer-badges {
        display: flex;
        flex-wrap: wrap;
        margin-top: 0.5rem;
        /*
                if you want to add space between the 88x31s:
                gap: 0.5rem;
                */
    }
</style>

