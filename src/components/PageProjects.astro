<style>
    .project-box {
        display: flex;
        gap: 1rem; /* space between boxes */
        flex-wrap: wrap; /* wraps to next line if too many */
    }

    .project-badges {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        padding: 0.5rem;
        flex-wrap: wrap;
    }
</style>
