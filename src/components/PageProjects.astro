            <hr class="header-divider" />
            <div class="header-badges">
                <Badge
                    src="/88x31/bandcamp.png"
                    alt="song on bandcamp"
                    href="https://sonnydoggy.bandcamp.com/track/mart-montes/"
                />
                <Badge
                    src="/88x31/youtube.png"
                    alt="song on youtube"
                    href="https://www.youtube.com/watch?v=hFZNawRunTo/"
