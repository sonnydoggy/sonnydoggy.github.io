        </div>

        <!-- shit n stuff -->

        <div class="project-box">
            <Project
                src="/img/sonnyminion.png"
                alt="image of a dog"
                href="https://www.youtube.com/@sawneydawgey/"

                title="it is november"

                year="2026"
                date=""
            />
            <div class="badges">
                <Badge
                    src="/88x31/bandcamp.png"
                    alt="song on bandcamp"
                    href="https://sonnydoggy.bandcamp.com/album/dreaming-in-a-faithful-world/"
                />
