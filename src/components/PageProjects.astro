                    <Badge
                        src="/88x31/bandcamp.png"
                        alt="song on bandcamp"
                        href="https://sonnydoggy.bandcamp.com/album/dreaming-in-a-faithful-world/"
                    />
                    <Badge
                        src="/88x31/youtube.png"
                        alt="song on youtube"
                        href="https://www.youtube.com/watch?v=qsA0-d0bP7k/"
                    />
                </div>
            </Project>
        </div>
