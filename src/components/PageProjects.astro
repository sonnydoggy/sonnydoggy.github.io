---
// i made a component for 88x31s, if you find it easier
// you can import it and use it in the header the same way
// i'd name it 88x31 but we can't start shit with numbers :c
import Badge from "./Badge.astro";
import Project from "./ProjectCard.astro";
---

<div class="page-header">
    <!-- new header box -->
    <div class="header-boxes">
        <!-- box 1 -->
        <div class="header-box">
            <img
                class="header-image"
                src="/img/sonnyminion.png"
                alt="im a dog boy"
            />
            <p class="header-text">my dog is cool and awesome</p>
            <hr class="header-divider" />
            <div class="header-badges">
                <Badge
                    src="/88x31/sonnyminion.gif"
                    alt="woof woof kaboom"
                    href="https://www.youtube.com/@sawneydawgey/"
                />
                <Badge
                    src="/88x31/sonnyminion.gif"
                    alt="woof woof kaboom"
                    href="https://www.youtube.com/@sawneydawgey/"
                />
            </div>
        </div>

        <!-- 2026 project -->
        <div class="header-box">
            <img
                class="header-image"
                src="/img/nothing project.jpg"
                alt="nothing project"
            />
            <hr class="header-divider" />
            <p class="header-text">nothing project</p>
            <span class="header-date">2026</span>
            <hr class="header-divider" />
            <div class="header-badges">
                <Badge
                    src="/88x31/newgrounds.gif"
                    alt="video on newgrounds"
                    href="https://www.newgrounds.com/portal/view/1047943/"
                />
                <Badge
                    src="/88x31/youtube.png"
                    alt="video on youtube"
                    href="https://www.youtube.com/watch?v=EdE0L9Tcnxc/"
                />
            </div>
        </div>

        <!-- 2025 project -->
        <div class="header-box">
            <img
                class="header-image"
                src="/img/rebound repertoire.png"
                alt="album picture"
            />
            <hr class="header-divider" />
            <p class="header-text">rebound repertoire</p>
            <span class="header-date">2025</span>
            <hr class="header-divider" />
            <div class="header-badges">
                <Badge
                    src="/88x31/bandcamp.png"
                    alt="song on bandcamp"
                    href="https://sonnydoggy.bandcamp.com/album/rebound-repertoire/"
                />
                <Badge
                    src="/88x31/youtube.png"
                    alt="song on youtube"
                    href="https://www.youtube.com/watch?v=UbcMoivIvuQ/"
                />
            </div>
        </div>

        <!-- 2024 project -->
        <div class="header-box">
            <img
                class="header-image"
