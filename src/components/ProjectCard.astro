---
import { Image } from "astro:assets";

// href and loading are optional
// loading tells the page how much to prioritise loading the image. defaults to lazy
// i suggest keeping lazy loading if you don't need to scroll or something to see it
// use eager if the image is visible right away on page load
interface Props {
    src: string;
    alt: string;
    text: string;
    year: string;
    date: string;
    href?: string;
    loading?: "lazy" | "eager";
}

const { src, alt, href, title, year, date, loading } = Astro.props;
---

<div class="card">
    <Image
        src={src}
        alt={alt}
        width={15 * 16}
        height={15 * 16}
        loading={loading || "lazy"}
        class="project-image"
    />
    {title && <p class="project-title">{title}</p>}
    {year && <p class="project-year">{year}</p>}
    {date && <p class="project-date">{date}</p>}
    <hr class="project-divider" />
    <slot />
</div>

<style>
    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--base03);
        background-color: var(--base01);
        width: 15rem;
        margin: 0;
    }

    .project-image {
        border-bottom: 2px solid var(--base03);
        margin: 0;
    }

    .project-title {
        text-align: center;
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
        padding: 0.5rem;
        margin: 0;
    }

    .project-year {
        text-align: right;
        font-size: 0.9em;
        opacity: 0.75;
        font-style: italic;
        padding: 0.5rem;
        margin: 0;
    }

    .project-date {
        text-align: right;
        font-size: 0.9em;
        opacity: 0.75;
        font-style: italic;
        padding: 0.5rem;
        margin: 0;
    }

    .project-divider {
        width: 100%;
        border: none;
        border-top: 2px solid var(--base03);
        margin: 0;
    }
</style>
