---
import { Image } from "astro:assets";

// href and loading are optional
// loading tells the page how much to prioritise loading the image. defaults to lazy
// i suggest keeping lazy loading if you don't need to scroll or something to see it
// use eager if the image is visible right away on page load
interface Props {
    src: string;
    alt: string;
    title: string;
    year: string;
    date: string;
    type: string;
    href?: string;
    loading?: "lazy" | "eager";
}

const { src, alt, href, title, year, date, type, loading } = Astro.props;
---

<div class="card" data-type={type ?? "Uncategorized"}>
    <Image
        src={src}
        alt={alt}
        width={15 * 16}
        height={15 * 16}
        loading={loading || "lazy"}
        class="project-image"
    />
    {title && <p class="project-title">{title}</p>}

    {(year || date) && (
        <div class="project-info">
            <p class="project-date">
                {year}

                <!-- i think it's stylistically cooler to only have year date, but the option is still here -->

                <!-- {year && date && ", "} -->
                <!-- {date} -->
            </p>
            {type && <p class="project-type">{type}</p>}
        </div>
    )}

    <hr class="project-divider" />
    <slot />
</div>

<style>
    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 2px solid var(--base03);
        background-color: var(--base01);
        width: 15rem;
        margin: 0;
    }

    .project-image {
        border-bottom: 2px solid var(--base03);
        margin: 0;
        width: 15rem;
        height: 15rem;
        object-fit: cover;
    }

    .project-title {
        align-self: flex-start;
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
        padding-top: 0.5rem;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        margin: 0;
    }

    .project-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin: 0;
        box-sizing: border-box;
    }

    .project-date {
        font-size: 0.9em;
        opacity: 0.75;
        font-style: italic;
        padding: 0.5rem;
        margin: 0;
    }

    .project-type {
        font-size: 0.9em;
        opacity: 0.75;
        font-style: italic;
        padding: 0.5rem;
        margin: 0;
    }

    .project-divider {
        width: 100%;
        border: none;
        border-top: 2px solid var(--base03);
        margin: 0;
    }
</style>
