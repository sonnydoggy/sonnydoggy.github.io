---
// astro image optimisation component
import { Image } from "astro:assets";
---

<header class="page-header">
    <div class="profile">
        <img
            class="avatar"
            src="https://avatars.githubusercontent.com/u/113544671"
            alt="avatar"
            loading="eager"
        />
        <div class="bio">
            <h1 class="profile-name">sonnydoggy</h1>
            <p class="profile-bio">
                a creative generalist <span id="random-verb">floating</span>{" "}
                across the <span id="random-descriptor">interwebs</span>
            </p>
            <nav class="badges">
                <a href="https://sonnydoggy.bandcamp.com/">
                    <Image
                        src="/88x31/bandcamp.gif"
                        alt="bandcamp"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://bsky.app/profile/sonnydoggy.bsky.social/">
                    <Image
                        src="/88x31/bluesky.gif"
                        alt="bluesky"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://www.chess.com/member/sonnydoggy/">
                    <Image
                        src="/88x31/chess.png"
                        alt="chessler"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://github.com/sonnydoggy/">
                    <Image
                        src="/88x31/github.png"
                        alt="githubby"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://sonnydoggy.newgrounds.com//">
                    <Image
                        src="/88x31/newgrounds.gif"
                        alt="newgrounds"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://www.youtube.com/@sawneydawgey/">
                    <Image
                        src="/88x31/sonnyminion.gif"
                        alt="woof woof kaboom"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://www.tumblr.com/sonnydoggy/">
                    <Image
                        src="/88x31/tumblr.png"
                        alt="tumblerone"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://www.twitch.tv/sonnydoggy/">
                    <Image
                        src="/88x31/twitch.png"
                        alt="twitch"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://www.youtube.com/@sonnydog/">
                    <Image
                        src="/88x31/youtube.png"
                        alt="youtube"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
                <a href="https://www.youtube.com/@sonnydoggymusic/">
                    <Image
                        src="/88x31/ytm.png"
                        alt="youtube music"
                        width={88}
                        height={31}
                        loading="eager"
                    />
                </a>
            </nav>
        </div>
    </div>
    <div class="music-status">
        <div class="music-info">
            <span class="music-title">dingle dongle</span>
            <span class="music-artist">sonny the dog</span>
        </div>
        <img class="music-artwork" loading="eager" src="/img/sonnyminion.png" />
    </div>
</header>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid var(--base02);
    }

    .profile {
        display: flex;
        gap: 1rem;
    }

    .bio {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        margin-left: -0.5rem;
    }

    .profile-name,
    .profile-bio {
        margin: 0;
    }

    .badges {
        margin-block: 0.5rem;
    }

    .avatar {
        aspect-ratio: 1 / 1;
        height: 8rem;
    }

    .music-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 2px solid var(--base03);
        padding-left: 0.5rem;
        background-color: var(--base01); /* subtle background tint */
    }

    .music-artist {
        text-align: right;
        font-size: 0.9em;
        opacity: 0.75;
        font-style: italic;
    }

    .music-info {
        display: flex;
        flex-direction: column;
    }

    .music-artwork {
        aspect-ratio: 1 / 1;
        height: 6rem;
        animation: fadeIn 10s linear;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .music-title,
    .music-artist {
        text-align: right;
    }
</style>

<script>
    const POLLING_INTERVAL_SEC = 30;

    const LFM_URL = "https://libre.fm/2.0/";
    const MB_URL = "https://musicbrainz.org/ws/2/release/";
    const CAA_URL = "https://coverartarchive.org/release/";

    const lfmParams = new URLSearchParams({
        method: "user.getRecentTracks",
        user: "sonnydoggy",
        format: "json",
        limit: "1",
    });
    const lfmUrl = `${LFM_URL}?${lfmParams.toString()}`;

    let errCount = {
        lfm: 0,
        mb: 0,
        caa: 0,
    };

    const updateMusic = async () => {
        if (errCount.lfm > 3 || errCount.mb > 3 || errCount.caa > 3) {
            setTimeout(updateMusic, 20_000);
            return;
        }

        let lfmResp;
        try {
            lfmResp = await fetch(lfmUrl);
        } finally {
            if (!lfmResp?.ok) {
                errCount.lfm++;
                setTimeout(updateMusic, 1_000);
                return;
            }
        }

        const data = await lfmResp.json();
        const track = data.recenttracks.track[0] || data.recenttracks.track;

        const mbidLookupParams = new URLSearchParams({
            query: `artist:${track.artist["#text"]} AND release:${track.album["#text"]}`,
            fmt: "json",
        });

        let mbidResp;
        try {
            mbidResp = await fetch(`${MB_URL}?${mbidLookupParams.toString()}`);
        } finally {
            if (!mbidResp?.ok) {
                errCount.mb++;
                setTimeout(updateMusic, 1_000);
                return;
            }
        }

        const mbid = (await mbidResp.json()).releases[0].id;

        let artworkResp;
        try {
            artworkResp = await fetch(`${CAA_URL}${mbid}`);
        } finally {
            if (!artworkResp?.ok) {
                errCount.caa++;
                setTimeout(updateMusic, 1_000);
                return;
            }
        }

        const artworkUrl = (await artworkResp.json()).images[0].thumbnails
            .small;

        const titleEl = document.querySelector(
            ".music-title",
        )! as HTMLSpanElement;
        const artistEl = document.querySelector(
            ".music-artist",
        )! as HTMLSpanElement;
        const artworkEl = document.querySelector(
            ".music-artwork",
        )! as HTMLImageElement;

        titleEl.textContent = track.name;
        artistEl.textContent = track.artist["#text"];

        artworkEl.src = artworkUrl;
        artworkEl.style.animation = "none";
        artworkEl.alt = `${track.name} by ${track.artist["#text"]}`;

        errCount = { lfm: 0, mb: 0, caa: 0 };
        setTimeout(updateMusic, POLLING_INTERVAL_SEC * 1_000);
    };

    void updateMusic();
</script>

<script>
    const VERBS = [
        "sauntering",
        "strolling",
        "drifting",
        "rambling",
        "migrating",
        "roaming",
        "wandering",
        "meandering",
        "leaping",
        "floating",
        "sailing",
        "gliding",
        "wafting",
        "swimming",
        "spinning",
        "turning",
        "touring",
        "whirling",
        "swirling",
        "strolling",
        "frolicking",
        "hopping",
        "exploding",
    ];

    const DESCRIPTORS = [
        "world wide web",
        "information highway",
        "interwebs",
        "cyber frontier",
        "digital wilderness",
        "tubes",
        "net",
        "web",
        "nether dimension",
        "partially shared computers",
        "- (IMPORTANT) sam altman is trying to reach you about your unused ram",
        "cyberspace",
        "digital playground",
        "meadows",
        "fields",
        "continents",
        "earth",
        "moon",
        "stars",
        "solar system",
        "digital beyond",
        "exploding building is exploding rn",
    ];

    function pickRandom(arr: string[]): string {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    const verbEl = document.getElementById("random-verb")! as HTMLElement;
    const descEl = document.getElementById("random-descriptor")! as HTMLElement;

    verbEl.textContent = pickRandom(VERBS);
    descEl.textContent = pickRandom(DESCRIPTORS);
</script>
